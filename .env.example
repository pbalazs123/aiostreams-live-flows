# Copy to .env and fill in. Never commit .env.

# How this container reaches AIOStreams, and the Docker network they share.
AIOSTREAMS_URL=http://aiostreams:3000
AIOSTREAMS_NETWORK=aiostreams_default

# An AIOStreams admin user. Use one made only for this. Read "The admin login" in the README.
AIOSTREAMS_USER=liveflows
AIOSTREAMS_PASSWORD=

# Optional: a password for the page itself. Use it if anyone but you can reach the port.
FLOWS_PASSWORD=

# Optional: 1 removes viewer IPs, usernames, countries and filenames before they reach any browser.
FLOWS_HIDE_VIEWERS=

# Optional: nicer names for sources, for example debrid=TorBox,addon.example.org=My addon
FLOWS_SOURCE_NAMES=

# Optional: your time zone for the logs.
TZ=UTC
